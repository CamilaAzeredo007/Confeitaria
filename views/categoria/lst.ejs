<%-include('../cabecalho.ejs')%>
<h1>Categorias</h1>

<div class="search">
    <form action="" method="post">
        <input type="text" name="filtro" placeholder="digite o nome">
        <button type="submit" class="btn">Pesquisar</button>
    </form>
</div>

<div class="menu">
    <ul>
        <li><a href="/categoria/add" class="btn add">+ Categoria</a></li>
    </ul>
</div>

<table>
    <tr>
        <th>Nome</th>
        <th>Ações</th>
    </tr>

    <%for (const {id, nome} of Categorias) {%>
    <tr>
        <td><%=nome%></td>
        <td>
            <a href="/categoria/edt/<%=id%>" class="btn edit">Editar</a>
            <a href="/categoria/del/<%=id%>" class="btn delete">Excluir</a>
        </td>
    </tr>
    <%}%>
</table>

<%-include('../rodape.ejs')%>
