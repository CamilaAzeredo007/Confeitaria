<%-include('../cabecalho.ejs')%>
<h1>Editar Pedido</h1>
    <div>
        <a href="/pedido/lst">Listar</a>
    </div>
<div>
    <form  method="post">
       
        <label>Nome do Pedido:</label>
        <input type="text" name="nome" 
        value="<%=Pedido.nome%>"><br>

        <label>Status:</label>
        <input type="text" name="status"
        value="<%=Pedido.status%>"><br>

        <label>Valor Total:</label>
        <input type="number" name="valorTotal" step="0.01"
        value="<%=Pedido.valorTotal%>"><br>

        <label>Forma de Pagamento:</label>
        <select name="formaPagamento">
            <option value="Dinheiro" <%= Pedido.formaPagamento === "Dinheiro" ? "selected" : "" %>>Dinheiro</option>
            <option value="Cartão de Crédito" <%= Pedido.formaPagamento === "Cartão de Crédito" ? "selected" : "" %>>Cartão de Crédito</option>
            <option value="Cartão de Débito" <%= Pedido.formaPagamento === "Cartão de Débito" ? "selected" : "" %>>Cartão de Débito</option>
            <option value="PIX" <%= Pedido.formaPagamento === "PIX" ? "selected" : "" %>>PIX</option>
        </select><br>

        <label>Data do Pedido:</label>
        <input type="date" name="dataPedido"
        value="<%=Pedido.dataPedido.toISOString().split('T')[0]%>"><br>

        <div class="mb-3">
            <label for="cliente" class="form-label">Cliente</label>
            <select name="cliente" id="cliente" class="form-control">
                <option value="">Selecione</option>
                <%Clientes.forEach(function(c) { %>
                    <option value="<%=c.id%>" 
                        <%= (Pedido.cliente && c.id.toString() === Pedido.cliente.toString())
                         ? 'selected': '' %>
                    >
                        <%=c.nome%>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Salvar Alterações</button>
        
    </form>
</div>

<%-include('../rodape.ejs')%>