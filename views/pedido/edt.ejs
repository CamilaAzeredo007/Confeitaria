<%-include('../cabecalho.ejs')%>
<h1>Editar Pedido</h1>

<div class="menu">
    <ul>
        <li><a href="/pedido/lst">Listar</a></li>
    </ul>
</div>

<form method="post">
    <div class="form-group">
        <label for="nome">Nome do Pedido:</label>
        <input type="text" id="nome" name="nome" value="<%=Pedido.nome%>">
    </div>

    <div class="form-group">
        <label for="status">Status:</label>
        <input type="text" id="status" name="status" value="<%=Pedido.status%>">
    </div>

    <div class="form-group">
        <label for="valorTotal">Valor Total:</label>
        <input type="number" id="valorTotal" name="valorTotal" step="0.01" value="<%=Pedido.valorTotal%>">
    </div>

    <div class="form-group">
        <label for="formaPagamento">Forma de Pagamento:</label>
        <select name="formaPagamento" id="formaPagamento">
            <option value="Dinheiro" <%= Pedido.formaPagamento === "Dinheiro" ? "selected" : "" %>>Dinheiro</option>
            <option value="Cartão de Crédito" <%= Pedido.formaPagamento === "Cartão de Crédito" ? "selected" : "" %>>Cartão de Crédito</option>
            <option value="Cartão de Débito" <%= Pedido.formaPagamento === "Cartão de Débito" ? "selected" : "" %>>Cartão de Débito</option>
            <option value="PIX" <%= Pedido.formaPagamento === "PIX" ? "selected" : "" %>>PIX</option>
        </select>
    </div>

    <div class="form-group">
        <label for="dataPedido">Data do Pedido:</label>
        <input type="date" id="dataPedido" name="dataPedido" value="<%=Pedido.dataPedido.toISOString().split('T')[0]%>">
    </div>

    <div class="form-group">
        <label for="cliente">Cliente</label>
        <select name="cliente" id="cliente">
            <option value="">Selecione</option>
            <%Clientes.forEach(function(c) { %>
                <option value="<%=c.id%>"
                    <%= (Pedido.cliente && c.id.toString() === Pedido.cliente.toString())
                     ? 'selected': '' %>
                >
                    <%=c.nome%>
                </option>
            <% }) %>
        </select>
    </div>

    <button type="submit" class="btn edit">Salvar Alterações</button>
</form>

<%-include('../rodape.ejs')%>
