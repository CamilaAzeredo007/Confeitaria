<%-include('../cabecalho.ejs')%>
<h1>Produtos</h1>

<div class="search">
    <form action="" method="post">
        <input type="text" name="filtro" placeholder="digite o nome do produto">
        <button type="submit" class="btn">Pesquisar</button>
    </form>
</div>

<div class="menu">
    <ul>
        <li><a href="/produto/add" class="btn add">+ Produto</a></li>
    </ul>
</div>

<table>
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Disponível</th>
        <th>Foto</th>
        <th>Categoria</th>
        <th>Ações</th>
    </tr>

    <% Produtos.forEach(function(p) { %>
        <tr>
            <td><%=p.nome%></td>

            <td>R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %></td>

            <td><%=p.disponivel ? 'Sim' : 'Não' %></td>

            <td>
                <% if (p.foto) { %>
                    <img
                        class="foto-thumb"
                        src="data:<%= p.tipoFoto %>;base64,<%= p.foto.toString('base64') %>"
                    >
                <% } %>
            </td>

            <td><%=p.categoria != null ? p.categoria.nome: ""%></td>
             <br>

            <td>
                <a href="/produto/edt/<%= p.id %>" class="btn edit">Editar</a>
                <a href="/produto/del/<%= p.id %>" class="btn delete">Excluir</a>
            </td>
        </tr>
    <% }) %>
</table>

<%-include('../rodape.ejs')%>
