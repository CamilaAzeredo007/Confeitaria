<%-include('../cabecalho.ejs')%>

<h1>Produtos</h1>

<div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome do produto">
         <button type="submit">Pesquisar</button>
    </form>

<a href="/produto/add">+ produto</a>

<table>
    <tr>   
        <td>Nome</td>
        <td>Preço</td>
        <td>Disponível</td>
        <td>Foto</td>
        <td>Categoria</td>
        <td>Ações</td>
    </tr>

    <% Produtos.forEach(function(p) { %>
        <tr>
            <td>
                <%=p.nome%>
            </td>

            <td>
               R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %>
            </td>

            <td>
                <%=p.disponivel %>
            </td>

            <td>
                <% if (p.foto) { %>
                    <img 
                        src="data:<%= p.tipoFoto %>;base64,<%= p.foto.toString('base64') %>"
                        width="150"
                        height="150"
                    >
                <% } %>
            </td>

            <td>
                <%=p.categoria != null ? p.categoria.nome: ""%>
            </td>

            <td>
                <a href="/produto/edt/<%= p.id %>">Editar</a>
                <a href="/produto/del/<%= p.id %>">Excluir</a>
            </td>
        </tr>
    <% }) %>
</table>

<%-include('../rodape.ejs')%>
