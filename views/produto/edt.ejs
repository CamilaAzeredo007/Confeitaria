<%-include('../cabecalho.ejs')%>
<h1>Editar Produto</h1>

<div class="menu">
    <ul>
        <li><a href="/produto/lst">Listar</a></li>
    </ul>
</div>

<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="nome">Nome:</label>
        <input type="text" id="nome" name="nome" value="<%=Produto.nome%>">
    </div>

    <div class="form-group">
        <label for="preco">Preço:</label>
        <input type="number" id="preco" name="preco" step="0.01" value="<%=Produto.preco%>">
    </div>

    <div class="form-group">
        <label for="disponivel">Disponível:</label>
        <input type="checkbox" id="disponivel" name="disponivel" value="true" <%= Produto.disponivel ? 'checked' : '' %>>
    </div>

    <div class="form-group">
        <label for="foto">Nova Foto:</label>
        <input type="file" id="foto" name="foto" accept=".png,.jpg,.jpeg">
    </div>

    <div class="form-group">
        <label for="categoria">Categoria</label>
        <select name="categoria" id="categoria">
            <option value="">Selecione</option>
            <%Categorias.forEach(function(c) { %>
                <option value="<%=c.id%>"
                    <%= (Produto.categoria && c.id.toString() === Produto.categoria.toString())
                     ? 'selected': '' %>
                >
                    <%=c.nome%>
                </option>
            <% }) %>
        </select>
    </div>

    <button type="submit" class="btn edit">Salvar Alterações</button>
</form>

<%-include('../rodape.ejs')%>
