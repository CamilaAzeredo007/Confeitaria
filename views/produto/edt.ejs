<%-include('../cabecalho.ejs')%>
<h1>Editar Produto</h1>
<div>
<a href="/produto/edt/<%=Produto.id%>">Editar</a>
</div>
<div>
    <form  method="post" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="nome" class="form-label">Nome:</label>
            <input type="text" name="nome" 
            value="<%=Produto.nome%>"><br>
        </div>

        <div class="mb-3">
            <label for="preco" class="form-label">Preço:</label>
            <input type="number" name="preco" step="0.01" 
            value="<%=Produto.preco%>"><br>
        </div>

        <div class="mb-3">
            <label for="disponivel" class="form-label">Disponivel:</label>
            <input type="checkbox" name="disponivel" 
            value="true" <%= Produto.disponivel ? 'checked' : '' %>><br>
        </div>

        <div class="mb-3">
            <label for="fotoN" class="form-label">Nova Foto:</label>
            <input type="file" name="foto" accept=".png,.jpg,.jpeg">
        </div>

        <div class="mb-3">
            <label for="categoria" class="form-label">Categoria</label>
            <select name="categoria" id="categoria" class="form-control">
                <option value="">Selecione</option>
                <%Categorias.forEach(function(c) { %>
                    <option value="<%=c.id%>" 
                        <%= (Produto.categoria && c.id.toString() === Produto.categoria.toString())
                         ? 'selected': '' %>
                    >
                        <%=c.nome%>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Salvar Alterações</button>
        
    </form>
</div>

<%-include('../rodape.ejs')%>