<%-include('cabecalho.ejs')%>
<main id="conteudo" class="static-main">
    <section class="page narrow">
         <span class="eyebrow">Cadastre-se no site</span>
         <h1>Crie sua conta.</h1>
         <form class="login" action="/site/pedidos">
            <label>
                Nome<input type="name" required placeholder="Digite seu nome">
            </label>
            <label>
                E-mail<input type="email" required placeholder="voce@email.com">
            </label>
            <label>
                Senha<input type="password" required placeholder="Digite sua senha">
            </label>
            <button class="primary">Entrar</button>
        </form>
    </section>
</main>
<%-include('rodape.ejs')%>