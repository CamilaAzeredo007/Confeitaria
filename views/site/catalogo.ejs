<%-include('cabecalho.ejs')%>
    <main id="conteudo" class="static-main">
        <section class="page">
            <span class="eyebrow">O cardápio da Amélie</span>
            <h1>Encontre seu próximo favorito.</h1>
            <p>Receitas artesanais, pequenos lotes e muitos motivos para sorrir.</p>
            <div class="catalog-tools">
                <div class="search">
                    <form action="/site/catalogo" method="post" >
                        <input type="text" name="filtro" placeholder="digite o nome do produto">
                        <button type="submit" class="btn">Pesquisar</button>
                    </form>
                </div>
<div class="chips" aria-label="Categorias">

    <button
        data-category="Todos"
        onclick="document.location.href='/site/catalogo'">
        Todos
    </button>

    <% Categorias.forEach(function(categoria) { %>

        <button
            data-category="<%=categoria.nome%>"
            onclick="document.location.href='/site/catalogo/<%=categoria._id%>'">

            <%=categoria.nome%>

        </button>

    <% }) %>

</div>
            </div>
            <div class="results">
                <span data-results></span>
                <span>Disponíveis para hoje</span>
            </div>
            <div class="product-grid" data-catalog></div>
            <div class="product-grid">

                <% Produtos.forEach(function(produto) { %>

                    <div class="produto">

                        <% if (produto.foto) { %>
                            <img class="foto-thumb" width="290" height="225"
                                src="data:<%= produto.tipoFoto %>;base64,<%= produto.foto.toString('base64') %>">
                            <% } %>

                                <h3>
                                    <%= produto.nome %>
                                </h3>

                                <p>
                                    R$ <%= Number(produto.preco).toFixed(2).replace('.', ',' ) %>
                                </p>

                                <p>
                                    <%= produto.categoria ? produto.categoria.nome : "" %>
                                </p>

                    </div>

                <% }) %>

            </div>
        </section>
</main>
<%-include('rodape.ejs')%>